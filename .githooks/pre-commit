#!/bin/sh
# Nemi commit guard (staged content).
#
# Blocks a commit if any staged change matches a pattern in the local denylist
# at .git/nemi-forbidden-patterns (one extended regex per line, blank lines
# ignored). The denylist is deliberately untracked: the patterns themselves
# never enter the repository.
#
# Enable for this clone with:  git config core.hooksPath .githooks

list="$(git rev-parse --git-dir)/nemi-forbidden-patterns"
[ -f "$list" ] || exit 0

pattern="$(grep -v '^[[:space:]]*$' "$list" | paste -sd '|' -)"
[ -n "$pattern" ] || exit 0

if git diff --cached -U0 --no-color -- . | grep -nEi "$pattern" >/dev/null 2>&1; then
  echo "nemi: pre-commit blocked - staged content matches a forbidden pattern." >&2
  git diff --cached -U0 --no-color -- . | grep -nEi "$pattern" | head -5 >&2
  echo "nemi: remove the match, or update .git/nemi-forbidden-patterns if it is a false positive." >&2
  exit 1
fi

exit 0
